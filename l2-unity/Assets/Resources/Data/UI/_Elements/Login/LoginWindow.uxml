<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Placed by InterludeWindowLayout from docs/ui-original/Login.json. -->
    <ui:VisualElement name="LoginWindow" picking-mode="Ignore" class="login-window il-login">
        <ui:VisualElement name="L2Logo" picking-mode="Ignore" class="il-login-logo" />
        <ui:VisualElement name="LoginFrame" picking-mode="Ignore" class="il-login-frame">
            <ui:VisualElement name="IDInput" picking-mode="Ignore" class="il-field">
                <ui:Label text="ui.login.account" name="AccountLabel" picking-mode="Ignore" class="il-login-label l10n" />
                <ui:VisualElement name="UserInputBg" picking-mode="Ignore" class="il-edit">
                    <ui:VisualElement name="UserInputCapL" picking-mode="Ignore" class="il-edit-l" />
                    <ui:VisualElement name="UserInputCapM" picking-mode="Ignore" class="il-edit-m" />
                    <ui:VisualElement name="UserInputCapR" picking-mode="Ignore" class="il-edit-r" />
                </ui:VisualElement>
                <ui:TextField max-length="16" name="UserInputField" tabindex="1" class="il-login-input" />
            </ui:VisualElement>
            <ui:VisualElement name="PasswordInput" picking-mode="Ignore" class="il-field">
                <ui:Label text="ui.login.password" name="PasswordLabel" picking-mode="Ignore" class="il-login-label l10n" />
                <ui:VisualElement name="PasswordInputBg" picking-mode="Ignore" class="il-edit">
                    <ui:VisualElement name="PasswordInputCapL" picking-mode="Ignore" class="il-edit-l" />
                    <ui:VisualElement name="PasswordInputCapM" picking-mode="Ignore" class="il-edit-m" />
                    <ui:VisualElement name="PasswordInputCapR" picking-mode="Ignore" class="il-edit-r" />
                </ui:VisualElement>
                <ui:TextField password="true" tabindex="2" max-length="16" name="PasswordInputField" class="il-login-input" />
            </ui:VisualElement>
            <ui:Toggle label="ui.login.remember" name="RememberToggle" focusable="false" class="il-login-remember l10n" />
            <ui:Button text="ui.login.log_in" name="LoginButton" focusable="false" class="l2-button il-login-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.log_in" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Button text="ui.login.exit" name="ExitButton" focusable="false" class="l2-button il-login-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.exit" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Label tabindex="-1" name="LabelError" picking-mode="Ignore" class="il-login-error" />
        </ui:VisualElement>
        <ui:VisualElement name="LoginMenu" picking-mode="Ignore" class="il-login-menu">
            <ui:Button text="ui.login.new_account" name="NewAccountButton" focusable="false" class="l2-button il-login-menu-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.new_account" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Button text="ui.login.lost_account" name="LostAccountButton" focusable="false" class="l2-button il-login-menu-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.lost_account" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Button text="ui.login.options" name="OptionsButton" focusable="false" class="l2-button il-login-menu-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.options" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Button text="ui.login.production_team" name="ProductionTeamButton" focusable="false" class="l2-button il-login-menu-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.production_team" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
            <ui:Button text="ui.login.replay" name="ReplayButton" focusable="false" class="l2-button il-login-menu-btn l10n">
                <ui:VisualElement name="ButtonBg" picking-mode="Ignore" class="l2-button-bg" />
                <ui:Label text="ui.login.replay" name="ButtonLabel" picking-mode="Ignore" class="button-label il-login-btn-label l10n" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
