<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Interlude MainWnd + DetailStatusWnd (interface.xdat): 256x335 content, header 20, tabs 41. -->
    <ui:VisualElement name="Windows" class="root_windows character-info-window status-interlude-root" style="position: absolute; left: 0; bottom: 0; width: 256px; height: 396px; margin: 0; padding: 0; flex-direction: column; background-color: rgb(24, 32, 56); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(140, 120, 70); border-right-color: rgb(140, 120, 70); border-top-color: rgb(140, 120, 70); border-bottom-color: rgb(140, 120, 70);">
        <ui:VisualElement name="Header" class="drag-area status-interlude-header" style="margin: 0; padding: 0; height: 20px; min-height: 20px; max-height: 20px; flex-direction: row; flex-grow: 0; flex-shrink: 0; align-items: stretch; background-color: rgb(32, 48, 88); overflow: visible;">
            <ui:VisualElement name="Left-Frame-Element" style="flex-grow: 0; width: 16px; min-width: 16px; max-width: 16px; height: 20px;" />
            <ui:VisualElement name="Center-Frame-Element" style="flex-grow: 1; flex-shrink: 1; height: 20px; flex-direction: row; align-items: center; padding-left: 6px;">
                <ui:Label name="windows-name-label" text="Status" style="margin: 0; padding: 0; color: rgb(240, 240, 240); font-size: 12px; -unity-font-definition: url('project://database/Assets/Resources/Data/UI/Assets/Font/tahoma.ttf?fileID=12800000&amp;guid=96fb7a735e76e0742bf125e2d4734bf3&amp;type=3#tahoma'); -unity-text-align: middle-left; flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement name="Right-Frame-Element" style="flex-grow: 0; width: 16px; min-width: 16px; max-width: 16px; height: 20px;" />
            <ui:VisualElement name="HeaderButtons" style="position: absolute; right: 2px; top: 2px; margin: 0; padding: 0; flex-direction: row; height: 16px; width: 36px; align-items: center;">
                <ui:Button name="Minimize-Window-Button" class="minimize-btn btn-coll-frame" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin: 0 2px 0 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;" />
                <ui:Button name="Close-Window-Button" class="close-btn btn-close-frame" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1; flex-shrink: 1; min-height: 0; margin: 0; padding: 0; flex-direction: column;">
            <ui:VisualElement name="MainWndTabs" class="status-mainwnd-tabs" style="position: relative; width: 256px; height: 41px; margin: 0; padding: 0; flex-grow: 0; flex-shrink: 0;">
                <ui:VisualElement name="MainWndTabBack" style="position: absolute; left: 0; top: 0; width: 256px; height: 41px; margin: 0; padding: 0;" />
                <ui:Button name="MainWndTab1" class="status-mainwnd-tab status-mainwnd-tab-active" style="position: absolute; left: 4px; top: 0; width: 44px; height: 41px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;">
                    <ui:VisualElement name="MainWndTabIcon1" style="position: absolute; left: 6px; top: 4px; width: 32px; height: 32px; margin: 0; padding: 0;" />
                </ui:Button>
                <ui:Button name="MainWndTab2" class="status-mainwnd-tab" style="position: absolute; left: 52px; top: 0; width: 44px; height: 41px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;">
                    <ui:VisualElement name="MainWndTabIcon2" style="position: absolute; left: 6px; top: 4px; width: 32px; height: 32px; margin: 0; padding: 0;" />
                </ui:Button>
                <ui:Button name="MainWndTab3" class="status-mainwnd-tab" style="position: absolute; left: 100px; top: 0; width: 44px; height: 41px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;">
                    <ui:VisualElement name="MainWndTabIcon3" style="position: absolute; left: 6px; top: 4px; width: 32px; height: 32px; margin: 0; padding: 0;" />
                </ui:Button>
                <ui:Button name="MainWndTab4" class="status-mainwnd-tab" style="position: absolute; left: 148px; top: 0; width: 44px; height: 41px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;">
                    <ui:VisualElement name="MainWndTabIcon4" style="position: absolute; left: 6px; top: 4px; width: 32px; height: 32px; margin: 0; padding: 0;" />
                </ui:Button>
                <ui:Button name="MainWndTab5" class="status-mainwnd-tab" style="position: absolute; left: 196px; top: 0; width: 44px; height: 41px; margin: 0; padding: 0; background-color: rgba(0,0,0,0); border-width: 0;">
                    <ui:VisualElement name="MainWndTabIcon5" style="position: absolute; left: 6px; top: 4px; width: 32px; height: 32px; margin: 0; padding: 0;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="DetailStatusWnd" class="status-detail" style="position: relative; width: 256px; height: 335px; margin: 0; padding: 0; flex-grow: 0; flex-shrink: 0; overflow: hidden;">
