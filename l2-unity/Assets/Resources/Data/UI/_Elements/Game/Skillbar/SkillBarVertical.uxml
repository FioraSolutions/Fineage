<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="Slot" src="project://database/Assets/Resources/Data/UI/_Elements/Template/Slot.uxml" />
    <ui:Template name="InterludeHudVerticalColumn" src="project://database/Assets/Resources/Data/UI/_Elements/Template/InterludeHudVerticalColumn.uxml" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <ui:VisualElement name="SkillBar1" class="skillbar skillbar-vertical" style="height: 508px; min-height: 508px;">
        <ui:VisualElement name="Wrapper" class="skillbar-wrapper skillbar-wrapper-vertical">
            <ui:VisualElement name="DragArea" class="skillbar-drag skillbar-drag-vertical">
                <ui:Instance template="InterludeHudVerticalColumn" class="interlude-hud-vertical-column interlude-hud-vertical-column-vertical" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ExpandBtn" class="skillbar-footer-btn button-expand button-expand-vertical" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="MinimizeBtn" class="skillbar-footer-btn button-minimize button-minimize-vertical" />
            </ui:VisualElement>
            <ui:VisualElement name="InnerContainer" class="skillbar-inner-container skillbar-inner-container-vertical">
                <ui:VisualElement name="NumberGroupBox" class="skillbar-arrow-control skillbar-arrow-control-vertical">
                    <ui:VisualElement name="SkillArrowInputVertical" class="skill-arrow-input skill-arrow-input-vertical">
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="RightArrow" class="skillbar-footer-btn skillbar-arrow-input-right" style="margin-right: 5px;" />
                        <ui:TextField picking-mode="Ignore" focusable="false" readonly="true" name="DataField" value="1" class="skill-arrow-input-label" />
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="LeftArrow" class="skillbar-footer-btn skillbar-arrow-input-left" style="margin-left: -1px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SlotContainer" class="skillbar-slot-container skillbar-slot-container-vertical" style="margin-left: 4px; margin-top: 0; align-items: flex-start; padding-top: 1px; padding-bottom: 5px;">
                    <ui:VisualElement name="Darkener" class="skillbar-darkener skillbar-darkener-vertical" style="margin-left: -3px; width: 41px; margin-top: 151px; height: 153px;" />
                    <ui:VisualElement name="SlotAnchor1" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor2" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor3" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor4" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Spacer" class="skillbar-slot-spacer" style="flex-shrink: 0; width: 39px; flex-grow: 1;" />
                    <ui:VisualElement name="SlotAnchor5" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor6" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor7" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor8" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="Spacer" class="skillbar-slot-spacer" style="flex-shrink: 0; width: 38px;" />
                    <ui:VisualElement name="SlotAnchor9" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor10" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor11" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SlotAnchor12" class="skillbar-slot-anchor skillbar-slot-anchor-vertical">
                        <ui:Instance template="Slot" name="Slot" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="FooterContainer" class="footer-container-vertical">
                    <ui:VisualElement name="Footer" class="skillbar-footer skillbar-footer-vertical">
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="TooltipBtn" class="skillbar-footer-btn button-tooltip" />
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="RotateBtn" class="skillbar-footer-btn button-rotate" style="margin-top: 1px;" />
                        <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="LockBtn" class="skillbar-footer-btn button-lock" style="margin-top: 1px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
