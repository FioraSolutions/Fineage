<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Interlude MinimapWnd. MapBack is 334x392: top bar, 328-tall map hole, bottom bar.
         No region tab. Aden/Elmore tabs are a later chronicle. -->
    <engine:VisualElement name="MinimapWnd" style="width: 334px; height: 392px; position: absolute; overflow: hidden;">
        <engine:VisualElement name="map-host" style="position: absolute; left: 2px; top: 30px; width: 330px; height: 328px; overflow: hidden;" />
        <engine:VisualElement name="MapBack" picking-mode="Ignore" style="position: absolute; left: 0; top: 0; width: 334px; height: 392px; background-image: resource('Data/UI/Map/MinimapFrame'); -unity-background-scale-mode: stretch-to-fill;" />
        <engine:VisualElement name="drag-area" class="drag-area" style="position: absolute; left: 0; top: 0; width: 310px; height: 28px;" />
        <engine:Button text="ui.window.map.my_location" name="MyLocation" class="l2-button l10n" style="position: absolute; left: 8px; top: 362px; width: 76px; height: 23px; margin: 0; padding: 0; font-size: 10px;" />
        <engine:Button text="ui.window.map.party" name="PartyButton" class="l2-button l10n" style="position: absolute; left: 88px; top: 362px; width: 76px; height: 23px; margin: 0; padding: 0; font-size: 10px;" />
        <engine:Button text="" name="btn-close-frame" class="btn-close-frame map-window-close" style="position: absolute; right: 4px; top: 4px; width: 16px; height: 16px; margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0;" />
    </engine:VisualElement>
</engine:UXML>
