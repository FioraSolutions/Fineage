<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="inject_content" style="flex-grow: 1; width: auto; height: auto; max-width: none; max-height: none;">
        <engine:VisualElement name="viewport" style="flex-grow: 1; overflow: hidden; margin-left: 0; margin-right: 0; max-width: 294px; max-height: 300px; width: 294px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(253, 18, 18, 0.84); border-right-color: rgba(253, 18, 18, 0.84); border-top-color: rgba(253, 18, 18, 0.84); border-bottom-color: rgba(253, 18, 18, 0.84); border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; height: 300px;">
            <engine:VisualElement name="map" style="flex-grow: 0; background-image: resource(&apos;Data/UI/Map/WorldMap_Black&apos;); width: 1812px; height: 2620px; overflow: visible; flex-shrink: 0; position: absolute; top: 0; left: 0; bottom: 0; right: 0;">
                <engine:VisualElement name="minimapPos" style="flex-grow: 0; background-image: resource(&apos;Data/UI/Map/MinimapPos&apos;); flex-shrink: 0; position: absolute; width: 32px; height: 32px;" />
            </engine:VisualElement>
            <engine:VisualElement name="town-map-layer" style="display: none; position: absolute; top: 0; left: 0; width: 294px; height: 300px; background-color: rgba(0, 0, 0, 0.85);">
                <engine:VisualElement name="town-map-image" style="position: absolute; top: 6px; left: 6px; width: 282px; height: 282px; background-size: cover; -unity-background-scale-mode: scale-and-crop;">
                    <engine:VisualElement name="town-map-marker" style="position: absolute; width: 32px; height: 32px; background-image: resource(&apos;Data/UI/Map/Town/town_pin&apos;);" />
                </engine:VisualElement>
                <engine:Label name="town-map-title" text="Town" style="position: absolute; top: 290px; left: 8px; font-size: 12px; color: rgb(230, 220, 190);" />
                <engine:Button name="town-map-close" text="X" style="position: absolute; top: 4px; right: 4px; width: 18px; height: 18px; font-size: 11px; -unity-text-align: middle-center;" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
