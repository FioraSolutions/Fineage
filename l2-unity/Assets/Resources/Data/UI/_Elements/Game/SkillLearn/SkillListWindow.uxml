<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="WindowTemplate" src="project://database/Assets/Resources/Data/UI/_Elements/Template/WindowTemplate.uxml?fileID=9197481963319205126&amp;guid=57919e48a99c2de4787ca2b8810527ea&amp;type=3#WindowTemplate" />
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <ui:Instance name="windowTemplate" template="WindowTemplate" class="inventory-window skills-list-window">
        <AttributeOverrides element-name="windows-name-label" text="ui.window.skills" class="l10n" />
        <ui:VisualElement name="content" class="skills-panel">
            <ui:VisualElement name="InventoryTabView" focusable="true" class="skills-tab-view">
                <ui:VisualElement name="tab-header-container" class="skills-tab-headers">
                    <ui:VisualElement name="TabLine" class="skills-tab-header-line" />
                </ui:VisualElement>
                <ui:VisualElement name="skills-tab-chrome" class="skills-tab-chrome">
                    <ui:ScrollView name="tab-content-scroll" mode="Vertical" class="l2-scroll-view skills-tab-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                        <ui:VisualElement focusable="true" name="tab-content-container" class="skills-tab-body" />
                    </ui:ScrollView>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="Buttons" class="skills-standalone-buttons">
                <ui:Button name="CloseButton" class="l2-button">
                    <ui:VisualElement name="ButtonBg" class="l2-button-bg" />
                    <ui:Label text="ui.skills.cancel" picking-mode="Ignore" class="button-label l10n" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:Instance>
</ui:UXML>