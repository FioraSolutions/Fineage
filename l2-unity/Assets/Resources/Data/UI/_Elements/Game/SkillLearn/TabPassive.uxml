<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <ui:VisualElement name="Window" class="skills-tab-root">
        <ui:VisualElement name="Content" class="skills-tab-content">
            <ui:VisualElement name="AllPanel" class="skills-all-panel">
                <ui:VisualElement name="AbilityContent" class="skills-section skills-section-first row-ability-content">
                    <ui:VisualElement name="TopLabel" class="skills-section-header">
                        <ui:Button name="DF_Button_Ability" class="df-button-active-skills">
                            <ui:VisualElement name="LineWhite" class="df-line-active-skills" />
                        </ui:Button>
                        <ui:Label text="Ability skills" class="skills-section-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SkillBar" class="skills-section-body">
                        <ui:VisualElement name="RowAbility" class="skills-section-rows" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="SubjectContent" class="skills-section row-subject-content">
                    <ui:VisualElement name="TopLabel" class="skills-section-header">
                        <ui:Button name="DF_Button_Subject" class="df-button-active-skills">
                            <ui:VisualElement name="LineWhite" class="df-line-active-skills" />
                        </ui:Button>
                        <ui:Label text="Subject skills" class="skills-section-title" />
                    </ui:VisualElement>
                    <ui:VisualElement name="SkillBar" class="skills-section-body">
                        <ui:VisualElement name="RowSubject" class="skills-section-rows" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>