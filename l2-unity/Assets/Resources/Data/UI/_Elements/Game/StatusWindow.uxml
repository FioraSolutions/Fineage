<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <ui:GroupBox name="StatusWindow" class="status-window" style="width: 176px; height: 84px; align-self: auto; justify-content: space-evenly; align-items: flex-start; flex-direction: row; margin-top: 3px; margin-right: -1px; margin-bottom: -1px; margin-left: -2px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); transform-origin: left top; min-width: 175px; max-width: 400px; left: -1px;">
        <ui:VisualElement name="Frame_DF_Ver" template="Frame_DF_Ver" class="drag-area" style="height: auto; width: 18px; max-width: 18px; flex-grow: 1; align-items: flex-start; justify-content: flex-start; align-self: auto; -unity-background-scale-mode: stretch-to-fill; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;">
            <ui:GroupBox name="Frame_DF_Ver" style="height: auto; width: 18px; max-width: 18px; margin-top: -1px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-grow: 1;">
                <ui:VisualElement style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/Frame_DF_Ver_Small_Top.png?fileID=2800000&amp;guid=3616eb66b6343964d92d1c6d7d5a936d&amp;type=3#Frame_DF_Ver_Small_Top&apos;); height: 8px; max-height: 8px;" />
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/Frame_DF_Ver_Small_Center.png?fileID=2800000&amp;guid=3adb856d45b78b242a89388ef2b70652&amp;type=3#Frame_DF_Ver_Small_Center&apos;);" />
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/Frame_DF_Ver_Small_Center.png?fileID=2800000&amp;guid=3adb856d45b78b242a89388ef2b70652&amp;type=3#Frame_DF_Ver_Small_Center&apos;);" />
                <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/Frame_DF_Ver_Small_Bottom.png?fileID=2800000&amp;guid=4e98b48730be8f04ba5e021a1a1a32bc&amp;type=3#Frame_DF_Ver_Small_Bottom&apos;); height: 8px; max-height: 8px;" />
            </ui:GroupBox>
        </ui:VisualElement>
        <ui:GroupBox name="CenterContainer" class="ui-bg" style="flex-grow: 1; margin-top: 1px; margin-right: 0; margin-bottom: 2px; margin-left: 0; padding-top: 4px; padding-right: 3px; padding-bottom: 2px; padding-left: 3px;">
            <ui:VisualElement name="LevelContainer" style="flex-grow: 0; height: auto; font-size: 10px; flex-direction: row;">
                <ui:GroupBox name="LevelContainer" class="level-container" style="margin-top: 0; margin-right: 0; margin-bottom: 3px; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Status/ps_levelback.png?fileID=2800000&amp;guid=a6577a69848b54348847defd32813d5e&amp;type=3#ps_levelback&apos;); flex-basis: auto; flex-grow: 0; flex-shrink: 0; -unity-font-definition: url(&apos;project://database/Assets/Resources/Data/UI/Assets/Font/tahoma.ttf?fileID=12800000&amp;guid=96fb7a735e76e0742bf125e2d4734bf3&amp;type=3#tahoma&apos;); color: rgb(171, 138, 85); -unity-text-align: upper-center; font-size: 11px; flex-direction: column; -unity-slice-right: 10; -unity-slice-bottom: 12; -unity-slice-scale: 0; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 1px 1px 0.5px rgba(0, 0, 0, 0.65); letter-spacing: 0;">
                    <ui:Label text="1" name="LevelText" />
                </ui:GroupBox>
                <ui:Label text="Shnok" name="PlayerNameText" style="align-items: auto; margin-top: 2px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; -unity-text-align: upper-center; -unity-font-definition: url(&apos;project://database/Assets/Resources/Data/UI/Assets/Font/tahoma.ttf?fileID=12800000&amp;guid=96fb7a735e76e0742bf125e2d4734bf3&amp;type=3#tahoma&apos;); color: rgb(255, 255, 255); -unity-text-outline-width: 0.3px; text-shadow: 0.5px 0.5px 0 rgb(0, 0, 0); letter-spacing: 0; font-size: 11px; width: auto; scale: 1 1;" />
            </ui:VisualElement>
            <ui:GroupBox name="BarGroup" class="bar-container" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-grow: 1; height: auto;">
                <ui:VisualElement name="CpBarContainer" template="HpBar" class="bar-container" style="margin-bottom: 0; height: 12px;">
                    <ui:GroupBox name="CPBarBG" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar_Back');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar_Back');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar_Back');" />
                    </ui:GroupBox>
                    <ui:GroupBox name="CPBar" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_CpBar');" />
                    </ui:GroupBox>
                    <ui:Label text="CP" name="BarLabel" class="bar-label bar-label-name" style="align-items: flex-start; flex-direction: column; flex-shrink: 0; -unity-text-outline-width: 1px;" />
                    <ui:Label text="1234/1234" name="CPText" select-word-by-double-click="true" enable-rich-text="true" class="bar-label bar-label-numbers" style="letter-spacing: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="HPBarContainer" template="HpBar" class="bar-container" style="height: 12px;">
                    <ui:GroupBox name="HPBarBG" class="bar-inner" style="width: 100%;">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar_Back');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar_Back');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar_Back');" />
                    </ui:GroupBox>
                    <ui:GroupBox name="HPBar" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_HpBar');" />
                    </ui:GroupBox>
                    <ui:Label text="HP" name="BarLabel" class="bar-label bar-label-name" style="align-items: flex-start; flex-direction: column; flex-shrink: 0;" />
                    <ui:Label text="1234/1234" name="HPText" select-word-by-double-click="true" class="bar-label bar-label-numbers hp-text-label" style="letter-spacing: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="MPBarContainer" template="HpBar" class="bar-container" style="height: 12px;">
                    <ui:GroupBox name="MPBarBG" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar_Back');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar_Back');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar_Back');" />
                    </ui:GroupBox>
                    <ui:GroupBox name="MPBar" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar');" />
                        <ui:VisualElement name="BGCenter" class="center bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar');" />
                        <ui:VisualElement name="BGRight" class="right bar-height" style="background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_MpBar');" />
                    </ui:GroupBox>
                    <ui:Label text="MP" name="BarLabel" class="bar-label bar-label-name" style="align-items: flex-start; flex-direction: column; flex-shrink: 0;" />
                    <ui:Label text="1234/1234" name="MPText" select-word-by-double-click="true" class="bar-label bar-label-numbers" style="letter-spacing: 0;" />
                </ui:VisualElement>
                <ui:VisualElement name="EXPBarContainer" class="bar-container" style="height: 12px; margin-top: 1px;">
                    <ui:GroupBox name="EXPBarBG" class="bar-inner" style="width: 100%;">
                        <ui:VisualElement name="BGLeft" class="left" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar_Back');" />
                        <ui:VisualElement name="BGCenter" class="center" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar_Back');" />
                        <ui:VisualElement name="BGRight" class="right" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar_Back');" />
                    </ui:GroupBox>
                    <ui:GroupBox name="EXPBar" class="bar-inner">
                        <ui:VisualElement name="BGLeft" class="left" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar');" />
                        <ui:VisualElement name="BGCenter" class="center" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar');" />
                        <ui:VisualElement name="BGRight" class="right" style="height: 12px; background-image: resource('Data/UI/Status/Interlude/Status_Interlude_Ps_ExpBar');" />
                    </ui:GroupBox>
                    <ui:Label text="0.00%" name="EXPText" class="bar-label bar-label-numbers" style="font-size: 9px; letter-spacing: 0;" />
                </ui:VisualElement>
            </ui:GroupBox>
        </ui:GroupBox>
        <ui:VisualElement name="SizeControl" style="flex-grow: 1; flex-shrink: 0; height: 81px; max-width: 5px; margin-top: 1px; margin-bottom: 0; flex-direction: column; justify-content: flex-start; align-items: auto; margin-right: 0; margin-left: -3px; padding-top: 0; padding-bottom: 0; flex-basis: auto; padding-right: 0; padding-left: 0; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/ps_sizecontrol1.png?fileID=2800000&amp;guid=4fee6573590340f46b46bf6fd6a7834c&amp;type=3#ps_sizecontrol1&apos;); -unity-slice-scale: 1px; -unity-slice-top: 3; -unity-slice-bottom: 3; -unity-slice-right: 0; -unity-slice-left: 0; width: 5px;">
            <ui:VisualElement name="SizeControl" class="hor-resize-handle resize-hor" style="flex-grow: 1; flex-shrink: 0; height: 16px; max-width: 16px; margin-top: 0; margin-bottom: 0; flex-direction: column; justify-content: flex-start; align-items: auto; margin-right: 0; margin-left: 0; padding-top: 0; padding-bottom: 0; flex-basis: auto; padding-right: 0; padding-left: 0; background-image: url(&apos;project://database/Assets/Resources/Data/UI/Frame/Frame_DF_Ver/ps_sizecontrol2.png?fileID=2800000&amp;guid=79a5ea15512e50b41ab4f842c26a184f&amp;type=3#ps_sizecontrol2&apos;); -unity-slice-scale: 0; -unity-slice-top: 0; -unity-slice-bottom: 0; -unity-slice-right: 8; -unity-slice-left: 0; width: 7px; max-height: 16px; position: absolute; top: 5px; left: 0;" />
        </ui:VisualElement>
    </ui:GroupBox>
</ui:UXML>
