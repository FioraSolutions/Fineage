<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Chrome (frame, 64x23 tabs, ChatEditBox) comes from InterludeWindowLayout ChatWnd. -->
    <ui:VisualElement name="ChatWnd" focusable="true" class="chat-window">
        <ui:TextField name="ChatInputField" style="color: rgb(226, 226, 226); font-size: 11px; -unity-font-definition: resource('Data/UI/Assets/Font/tahoma');" />
    </ui:VisualElement>
</ui:UXML>
