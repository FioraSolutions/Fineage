<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Interlude SystemMsgWnd: list-only window above ChatWnd (C4+). Background = chatting_system. -->
    <ui:VisualElement name="SystemMsgWnd" class="system-msg-window" picking-mode="Position">
        <ui:ScrollView name="SystemMsgList" mode="Vertical" horizontal-scrolling="false" vertical-scrolling="true" class="system-msg-list">
            <ui:VisualElement name="SystemMsgContent" class="system-msg-content" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
