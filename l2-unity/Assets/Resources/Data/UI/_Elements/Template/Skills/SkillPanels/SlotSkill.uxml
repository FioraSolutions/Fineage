        <engine:VisualElement name="SlotBorder" class="slot-border">
            <engine:VisualElement name="SlotBg" class="slot-bg" />
            <engine:VisualElement name="ReuseBg" picking-mode="Ignore" class="slot-bg skills-slot-reuse-bg" />
