<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/Data/UI/_Elements/L2StyleSheet.uss?fileID=7433441132597879392&amp;guid=72e99cc94b130bf4ba100dceaa830b13&amp;type=3#L2StyleSheet" />
    <!-- Interlude window chrome: BackTexture starts at y=20 — header is 20px FrameBack + sys buttons. -->
    <ui:VisualElement name="Windows" class="root_windows inventory-interlude-root" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-grow: 1; flex-direction: column; background-color: rgb(24, 32, 56); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: rgb(140, 120, 70); border-right-color: rgb(140, 120, 70); border-top-color: rgb(140, 120, 70); border-bottom-color: rgb(140, 120, 70);">
        <ui:VisualElement name="Header" class="drag-area inventory-interlude-header" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 20px; min-height: 20px; max-height: 20px; flex-direction: row; flex-grow: 0; flex-shrink: 0; align-items: stretch; background-color: rgb(32, 48, 88); overflow: visible;">
            <ui:VisualElement name="Left-Frame-Element" style="flex-grow: 0; width: 16px; min-width: 16px; max-width: 16px; height: 20px; background-image: resource(&apos;Data/UI/Frame/Interlude/FrameBackLeft&apos;); -unity-background-scale-mode: stretch-to-fill;" />
            <ui:VisualElement name="Center-Frame-Element" style="flex-grow: 1; flex-shrink: 1; height: 20px; background-image: resource(&apos;Data/UI/Frame/Interlude/FrameBackMid&apos;); -unity-background-scale-mode: stretch-to-fill; flex-direction: row; align-items: center; padding-left: 6px;">
                <ui:Label tabindex="-1" text="Inventory" parse-escape-sequences="true" display-tooltip-when-elided="true" name="windows-name-label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(240, 240, 240); font-size: 12px; -unity-font: resource(&apos;Data/UI/Font/tahoma&apos;); -unity-text-align: middle-left; flex-grow: 1;" />
            </ui:VisualElement>
            <ui:VisualElement name="Right-Frame-Element" style="flex-grow: 0; width: 16px; min-width: 16px; max-width: 16px; height: 20px; background-image: resource(&apos;Data/UI/Frame/Interlude/FrameBackRight&apos;); -unity-background-scale-mode: stretch-to-fill;" />
            <ui:VisualElement name="HeaderButtons" style="position: absolute; right: 2px; top: 2px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: row; height: 16px; width: 54px; align-items: center;">
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Options-Window-Button" class="options-btn" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; background-image: resource(&apos;Data/UI/Frame/Interlude/FrameOptionBtn&apos;); -unity-background-scale-mode: stretch-to-fill;" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Minimize-Window-Button" class="minimize-btn btn-coll-frame" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 0; margin-right: 2px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="Close-Window-Button" class="close-btn btn-close-frame" style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; background-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Body" style="flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: rgb(12, 12, 14);" />
    </ui:VisualElement>
</ui:UXML>
