<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fineage.Client.Domain.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Linked client domain helpers that are engine-free. Unity cannot reference
         Assembly-CSharp from a test assembly, so this host compiles them directly. -->
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Contract\**\*.cs"
             Link="Client\Net.Contract\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\FineageWireConfig.cs" Link="Client\FineageWireConfig.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\LobbyCharacter.cs" Link="Client\LobbyCharacter.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2Chat.cs" Link="Client\ZoneV2Chat.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2Clan.cs" Link="Client\ZoneV2Clan.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2Death.cs" Link="Client\ZoneV2Death.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2DomainStructs.cs" Link="Client\ZoneV2DomainStructs.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2Enchant.cs" Link="Client\ZoneV2Enchant.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2Equip.cs" Link="Client\ZoneV2Equip.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2NpcSession.cs" Link="Client\ZoneV2NpcSession.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Domain\ZoneV2SystemLines.cs" Link="Client\ZoneV2SystemLines.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Playtest\PlaytestEndpoint.cs" Link="Client\PlaytestEndpoint.cs" />
  </ItemGroup>
</Project>
