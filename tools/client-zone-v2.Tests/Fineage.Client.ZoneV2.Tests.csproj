<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Fineage.Client.ZoneV2.Tests</RootNamespace>
    <!-- This host exercises the V2 MessagePack adapters, which Unity compiles with the
         FINEAGE_V2_WIRE define. Without it the linked FineageWireConfig falls back to Net
         and the V2 playtest-host assertions fail. -->
    <DefineConstants>$(DefineConstants);FINEAGE_V2_WIRE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\zone-server\Fineage.ZoneServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked client adapters can reference Fineage.Net.Contract types; link the whole folder
         so the next such dependency does not re-break this test project. -->
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Net\Contract\**\*.cs"
             Link="Client\Net.Contract\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2Chat.cs" Link="Client\ZoneV2Chat.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2Death.cs" Link="Client\ZoneV2Death.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2Clan.cs" Link="Client\ZoneV2Clan.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2Enchant.cs" Link="Client\ZoneV2Enchant.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2SkillNotices.cs" Link="Client\ZoneV2SkillNotices.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\ZoneV2Equip.cs" Link="Client\ZoneV2Equip.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2MsgPack.cs" Link="Client\ZoneV2MsgPack.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2Messages.cs" Link="Client\ZoneV2Messages.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2MsgType.cs" Link="Client\ZoneV2MsgType.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2NpcWire.cs" Link="Client\ZoneV2NpcWire.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\NpcHtmlSubset.cs" Link="Client\NpcHtmlSubset.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2NpcSession.cs" Link="Client\ZoneV2NpcSession.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\Wire\ZoneV2SystemLines.cs" Link="Client\ZoneV2SystemLines.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Playtest\PlaytestEndpoint.cs" Link="Client\PlaytestEndpoint.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\FineageWireConfig.cs" Link="Client\FineageWireConfig.cs" />
    <Compile Include="..\..\l2-unity\Assets\Scripts\Networking\Adapters\V2\LobbyCharacter.cs" Link="Client\LobbyCharacter.cs" />
  </ItemGroup>
</Project>
